{
  "openapi": "3.1.0",
  "info": {
    "title": "Chat API Gateway",
    "description": "\n    A FastAPI backend that provides a clean REST interface for the LangXchange chat service.\n\n    ## Features\n\n    - **Authentication**: Manage authentication with the external chat API\n    - **Sessions**: Create and manage chat sessions with AI agents\n    - **Messages**: Send messages and receive AI responses\n    - **Convenience Endpoint**: Quick chat endpoint for simple interactions\n\n    ## Getting Started\n\n    1. Use `/auth/login` to authenticate (or let the API auto-authenticate)\n    2. Create a session with `/sessions`\n    3. Send messages with `/sessions/{session_uuid}/messages`\n\n    Or use the convenience `/chat` endpoint for quick interactions.\n    ",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login",
        "description": "Authenticate with the external chat service.\n\nIf credentials are not provided, uses the default configured credentials.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "External API error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Auth Status",
        "description": "Check current authentication status.",
        "operationId": "auth_status_auth_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
