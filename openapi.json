    "/chat": {
      "post": {
        "tags": [
          "Quick Chat"
        ],
        "summary": "Quick chat endpoint",
        "description": "Convenience endpoint for quick chat interactions.\n\nThis endpoint handles session creation automatically if no session_uuid is provided.\nIdeal for simple, stateless chat interactions.\n\n- If `session_uuid` is provided, sends a message to that existing session\n- If `session_uuid` is not provided, creates a new session first",
        "operationId": "quick_chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuickChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
